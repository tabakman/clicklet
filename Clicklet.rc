// Forward slashes in file paths: rc.exe mangles doubled backslashes into control characters.

#include <windows.h>
#include "Resource.h"

// No named ICON resources: Explorer would show one of those instead of IDI_APPICON (Resource.h).
// appicon.ico and tray-enabled.ico are identical on purpose: keep them as separate resources.
IDI_APPICON        ICON  "res/appicon.ico"
IDI_TRAY_ENABLED   ICON  "res/tray-enabled.ico"
IDI_TRAY_DISABLED  ICON  "res/tray-disabled.ico"

IDB_ABOUT_LOGO BITMAP "res/logo_about.bmp"

// Strings stay ASCII: write (c), not a copyright sign, which rc.exe code-page handling can mangle.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CLICKLET_VERSION_MAJOR,CLICKLET_VERSION_MINOR,CLICKLET_VERSION_PATCH,0
 PRODUCTVERSION CLICKLET_VERSION_MAJOR,CLICKLET_VERSION_MINOR,CLICKLET_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Must agree with Translation below: 0409 = 0x409, 04B0 = 1200.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Tal Tabakman"
            VALUE "FileDescription",  "Clicklet"
            VALUE "FileVersion",      CLICKLET_VERSION_STRING
            VALUE "InternalName",     "Clicklet"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Tal Tabakman. MIT Licence."
            VALUE "OriginalFilename", "Clicklet.exe"
            VALUE "ProductName",      "Clicklet"
            VALUE "ProductVersion",   CLICKLET_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Moving the licence line or the link means moving CLICKLET_LINK_BAND_*_DLU in Clicklet.cpp.
IDD_ABOUT DIALOGEX 0, 0, 188, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About Clicklet"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ABOUT_LOGO, "Static", SS_BITMAP, 19, 10, 149, 33
    CTEXT           "", IDC_ABOUT_VERSION, 8, 50, 172, 10
    CTEXT           "MIT Licence.  Copyright (c) 2026 Tal Tabakman.", -1, 8, 66, 172, 10
    // No SS_NOTIFY: the static would take clicks from the dialog's link band.
    CONTROL         "", IDC_ABOUT_URL, "Static", SS_CENTER | SS_CENTERIMAGE, 8, 78, 172, 13
END
